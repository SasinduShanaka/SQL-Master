PORT=5000
# Copy this file to backend/.env before starting the backend.
MONGODB_URI=mongodb://127.0.0.1:27017/sqlmaster
# Set production only when serving the app over HTTPS (enables Secure cookies).
NODE_ENV=development
# Sessions use random tokens stored in HttpOnly cookies; no JWT secret is needed.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
